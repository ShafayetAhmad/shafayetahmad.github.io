{
  "name": "shafayetahmad.github.io",
  "version": "1.0.0",
  "private": true,
  "description": "Build scripts for Shafayet Ahmad Kanon's academic website (Jekyll, based on the AcademicPages theme)",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShafayetAhmad/shafayetahmad.github.io"
  },
  "license": "MIT",
  "homepage": "https://www.shafayetahmad.com",
  "dependencies": {
    "jquery": "^3.7.1",
    "plotly.js-dist-min": "^3.6.0"
  },
  "devDependencies": {
    "jslint": "^0.12.1",
    "onchange": "^7.1.0",
    "uglify-js": "^3.19.3"
  },
  "scripts": {
    "uglify": "uglifyjs assets/js/plugins/jquery.greedy-navigation.js assets/js/_main.js assets/js/theme.js -c -m -o assets/js/main.min.js",
    "watch:js": "onchange \"assets/js/**/*.js\" -e \"assets/js/main.min.js\" -- npm run build:js",
    "build:js": "npm run uglify"
  }
}
